# Scam Detector AI — Environment variables
# Copy this file to .env and fill in values.
# Do NOT commit real keys. This key is read ONLY on the server
# (src/routes/api/*) and is never bundled into or exposed to the frontend.
# Never prefix it with VITE_ — that would expose it to the browser.

# Lovable AI Gateway key (provisioned automatically when deployed on Lovable).
LOVABLE_API_KEY=
